// Xue2021 only (run_study.sh adds conf/<study>.config when one exists).
// Lexogen QuantSeq 3' mRNA-seq FWD (GEO GSE167156 and GSE167881), single-end 79-86 nt, no UMIs.
// Salmon pseudo-alignment as for the other studies, with three tag-seq changes:
//  - poly(A)/poly(X) tails trimmed at the 3' end of reads,
//  - the first 12 nt removed (random-primer region, Lexogen's recommendation for FWD reads),
//  - no length correction: a 3' tag counts once per transcript whatever its length
//    (analysis/de_per_study.R lists Xue2021 in NO_LENGTH; library_exclusions.py in TAG_STUDIES).
params {
    extra_fastp_args        = '--trim_poly_x --trim_front1 12 --length_required 20'
    extra_salmon_quant_args = '--noLengthCorrection'
}
